    "pastel": {
      "light": "pastel-light",
      "dark": "pastel-dark"
    }
  },
  "notes": {
    "usage": "Resolve colors by semantic token name. All themes expose the same tokens.",
    "pastel": "Muted sage accents and warm neutral surfaces; foreground colors retain contrast.",
    "macOS": "Application palettes only. Native materials, window vibrancy, system accent preference and Increase Contrast require separate platform handling.",
    "brand": "The original retroTools green is retained as the decorative brand color. Use accent and on-accent for primary controls.",
    "accessibility": "Pair status colors with icons and labels. Text-disabled is for inactive controls only. Use focus-ring for keyboard focus. Decorative borders and progress tracks are not text colors."
  },
